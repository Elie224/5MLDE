    {
      "id": 12,
      "title": "WAPE de production par version",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT f.model_version, COUNT(*) AS n_feedbacks, SUM(ABS(f.actual_qty - f.predicted_qty)) / NULLIF(SUM(ABS(f.actual_qty)), 0) AS wape FROM (SELECT DISTINCT ON (stock_code, iso_week, model_version) stock_code, iso_week, model_version, actual_qty, predicted_qty, prediction_id FROM feedbacks WHERE predicted_qty IS NOT NULL ORDER BY stock_code, iso_week, model_version, created_at DESC) f LEFT JOIN predictions p ON p.prediction_id = f.prediction_id WHERE p.source IS NULL OR p.source <> 'loadtest' GROUP BY f.model_version ORDER BY f.model_version",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "wape"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      }
    },
    {
      "id": 13,
      "title": "WAPE par semaine",
      "type": "barchart",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 20
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "xField": "iso_week"
      },
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "model_version",
            "rowField": "iso_week",
            "valueField": "wape"
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT f.iso_week, f.model_version, SUM(ABS(f.actual_qty - f.predicted_qty)) / NULLIF(SUM(ABS(f.actual_qty)), 0) AS wape FROM (SELECT DISTINCT ON (stock_code, iso_week, model_version) stock_code, iso_week, model_version, actual_qty, predicted_qty, prediction_id FROM feedbacks WHERE predicted_qty IS NOT NULL AND iso_week IS NOT NULL ORDER BY stock_code, iso_week, model_version, created_at DESC) f LEFT JOIN predictions p ON p.prediction_id = f.prediction_id WHERE p.source IS NULL OR p.source <> 'loadtest' GROUP BY f.iso_week, f.model_version ORDER BY f.iso_week, f.model_version",
          "refId": "A"
        }
      ]
    },
