      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 'predictions' AS table_name, COUNT(*) AS n FROM predictions WHERE source <> 'loadtest' UNION ALL SELECT 'predictions_loadtest', COUNT(*) FROM predictions WHERE source = 'loadtest' UNION ALL SELECT 'feedbacks', COUNT(*) FROM feedbacks UNION ALL SELECT 'pipeline_runs', COUNT(*) FROM pipeline_runs UNION ALL SELECT 'alerts', COUNT(*) FROM alerts",
          "refId": "A"
        }
      ]
