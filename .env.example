# Copier en .env (jamais commité). Ports choisis pour éviter les conflits
# avec d'autres services locaux (Postgres déjà sur 5434-5436).
RETAIL_CONFIG=configs/config.yaml
RETAIL_DATA_CONFIG=configs/data.yaml
RETAIL_LOG_LEVEL=INFO
# Vide = fichier local mlruns/ (les tests pytest forcent file://).
# Démo / API / Prefect : même serveur Docker que `docker compose up -d mlflow`.
RETAIL_MLFLOW_TRACKING_URI=http://127.0.0.1:5001
RETAIL_ALERT_WEBHOOK_URL=http://127.0.0.1:8001/alerts
# SQLite si la ligne est commentée (tests). Démo Grafana : Postgres local.
RETAIL_DATABASE_URL=postgresql+psycopg://retail:change-me@127.0.0.1:5437/retail

POSTGRES_USER=retail
POSTGRES_PASSWORD=change-me
POSTGRES_DB=retail
POSTGRES_PORT=5437

MLFLOW_PORT=5001
PREFECT_PORT=4201
API_PORT=8001
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_PORT=9091
# Plusieurs workers Uvicorn : retail api --workers 2 (agrège via ce dossier)
# PROMETHEUS_MULTIPROC_DIR=data/reports/prom
# Sondage de l'alias champion par worker (0 = désactivé)
# RETAIL_CHAMPION_POLL_SECONDS=30
# Charge Locust (python load_tests/run.py)
# LOCUST_WEEK=2011-W48
# LOCUST_HOST=http://127.0.0.1:8001
